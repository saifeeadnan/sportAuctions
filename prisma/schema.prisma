// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  LEAGUE_ADMIN
  TEAM_MANAGER
  AUCTIONEER
  VIEWER
}

enum TournamentStatus {
  DRAFT
  ACTIVE
  COMPLETED
}

enum AuctionStatus {
  CREATED
  PRE_AUCTION_OPEN
  PRE_AUCTION_LOCKED
  BIDDING
  COMPLETED
}

enum AuctionType {
  LIVE
  SILENT
  FIXED_PRICE
}

enum AuctionPlayerStatus {
  AVAILABLE
  IN_PRE_AUCTION_POOL
  IN_BIDDING
  SOLD
  UNSOLD
}

enum SoldVia {
  PRE_AUCTION_DRAFT
  LIVE_BID
  ADMIN_ASSIGNED
}

enum TeamAuctionEntryStatus {
  CREATED
  PRE_AUCTION_DRAFTING
  PRE_AUCTION_SUBMITTED
  ALLOCATED_PRE_AUCTION
  AUCTION_LIVE
  FINAL
}

enum StrategyPreferenceType {
  MUST_HAVE
  AVOID
}

model User {
  id               String   @id @default(cuid())
  loginId          String   @unique
  passwordHash     String
  name             String
  role             Role
  managerBasePrice Decimal? @db.Decimal(10, 2)
  leagueId         String?
  league           League?  @relation(fields: [leagueId], references: [id])
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  createdRosters     PlayerRoster[]
  managedTeams       Team[]
  createdTournaments Tournament[]
  createdAuctions    Auction[]
  fantasyTeams       FantasyTeam[]
  uploadedRulesDocs  TournamentDocument[]
  loginEvents        LoginEvent[]
  analyticsSessions  AnalyticsSession[]
  sponsorClicks      SponsorClickEvent[]

  @@index([leagueId])
  @@map("users")
}

model League {
  id        String   @id @default(cuid())
  name      String   @unique
  type      String
  createdAt DateTime @default(now())

  users       User[]
  rosters     PlayerRoster[]
  tournaments Tournament[]
  logo        LeagueLogo?

  @@map("leagues")
}

model PlayerRoster {
  id          String   @id @default(cuid())
  name        String
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  leagueId    String
  league      League   @relation(fields: [leagueId], references: [id])
  createdAt   DateTime @default(now())

  players     Player[]
  tournaments Tournament[]

  @@index([leagueId])
  @@map("player_rosters")
}

model Player {
  id              String       @id @default(cuid())
  rosterId        String
  roster          PlayerRoster @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  name            String
  position        String?
  age             Int?
  loginId         String?
  defaultCategory String?
  previousTeam    String?
  photoUrl        String?
  rating          Decimal?     @db.Decimal(6, 2)
  battingRating   Decimal?     @db.Decimal(6, 2)
  bowlingRating   Decimal?     @db.Decimal(6, 2)
  fieldingRating  Decimal?     @db.Decimal(6, 2)
  priorStats      Json?
  createdAt       DateTime     @default(now())

  auctionPlayers AuctionPlayer[]

  @@index([rosterId])
  @@map("players")
}

model Tournament {
  id          String           @id @default(cuid())
  name        String
  rosterId    String?
  roster      PlayerRoster?    @relation(fields: [rosterId], references: [id])
  numTeams    Int
  squadSize   Int
  startDate   DateTime
  endDate     DateTime
  status      TournamentStatus @default(DRAFT)
  createdById String
  createdBy   User             @relation(fields: [createdById], references: [id])
  leagueId    String
  league      League           @relation(fields: [leagueId], references: [id])
  createdAt   DateTime         @default(now())

  teams         Team[]
  auctions      Auction[]
  rulesDocument TournamentDocument?
  sponsors      TournamentSponsor[]

  @@index([rosterId])
  @@index([leagueId])
  @@map("tournaments")
}

model TournamentDocument {
  id           String     @id @default(cuid())
  tournamentId String     @unique
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  fileName     String
  mimeType     String
  data         Bytes
  uploadedById String
  uploadedBy   User       @relation(fields: [uploadedById], references: [id])
  uploadedAt   DateTime   @default(now())

  @@map("tournament_documents")
}

model TournamentSponsor {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name         String
  websiteUrl   String?
  mimeType     String
  data         Bytes
  createdAt    DateTime   @default(now())

  clicks SponsorClickEvent[]

  @@index([tournamentId])
  @@map("tournament_sponsors")
}

model TeamSponsorImage {
  id         String   @id @default(cuid())
  teamId     String   @unique
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  mimeType   String
  data       Bytes
  uploadedAt DateTime @default(now())

  @@map("team_sponsor_images")
}

model LeagueLogo {
  id         String   @id @default(cuid())
  leagueId   String   @unique
  league     League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  mimeType   String
  data       Bytes
  uploadedAt DateTime @default(now())

  @@map("league_logos")
}

model Team {
  id                  String     @id @default(cuid())
  tournamentId        String
  tournament          Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name                String
  managerId           String?
  manager             User?      @relation(fields: [managerId], references: [id])
  managerOccupiesSlot Boolean    @default(true)
  createdAt           DateTime   @default(now())

  entries      TeamAuctionEntry[]
  sponsorImage TeamSponsorImage?

  @@unique([tournamentId, name])
  @@index([managerId])
  @@map("teams")
}

model Auction {
  id           String        @id @default(cuid())
  tournamentId String
  tournament   Tournament    @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name         String
  teamBudget   Decimal       @db.Decimal(12, 2)
  status       AuctionStatus @default(CREATED)
  auctionType  AuctionType   @default(LIVE)
  createdById  String
  createdBy    User          @relation(fields: [createdById], references: [id])
  createdAt    DateTime      @default(now())
  startedAt    DateTime?
  completedAt  DateTime?

  categories     AuctionCategory[]
  auctionPlayers AuctionPlayer[]
  entries        TeamAuctionEntry[]
  fantasyTeams   FantasyTeam[]

  @@index([tournamentId])
  @@map("auctions")
}

model AuctionCategory {
  id                 String   @id @default(cuid())
  auctionId          String
  auction            Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  name               String
  basePrice          Decimal  @db.Decimal(12, 2)
  preAuctionEligible Boolean  @default(true)
  bidIncrement       Decimal? @db.Decimal(12, 2)

  auctionPlayers AuctionPlayer[]
  budgetTargets  AuctionCategoryBudgetTarget[]

  @@unique([auctionId, name])
  @@map("auction_categories")
}

model AuctionPlayer {
  id                   String              @id @default(cuid())
  auctionId            String
  auction              Auction             @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  playerId             String
  player               Player              @relation(fields: [playerId], references: [id])
  categoryId           String
  category             AuctionCategory     @relation(fields: [categoryId], references: [id])
  status               AuctionPlayerStatus @default(AVAILABLE)
  soldVia              SoldVia?
  soldToEntryId        String?
  soldToEntry          TeamAuctionEntry?   @relation("SoldPlayers", fields: [soldToEntryId], references: [id])
  soldPrice            Decimal?            @db.Decimal(12, 2)
  soldAt               DateTime?
  biddingOrder         Int?
  points               Decimal?            @db.Decimal(10, 2)
  currentBidAmount     Decimal?            @db.Decimal(12, 2)
  currentBidderEntryId String?
  currentBidderEntry   TeamAuctionEntry?   @relation("CurrentBidder", fields: [currentBidderEntryId], references: [id])
  bidCooldownUntil     DateTime?

  draftPicks   PreAuctionSubmission[]
  fantasyPicks FantasyTeamPlayer[]
  bids         Bid[]
  preferences  AuctionPlayerPreference[]
  predictions  AuctionPlayerPrediction[]

  @@unique([auctionId, playerId])
  @@index([auctionId, status])
  @@map("auction_players")
}

model Bid {
  id                 String           @id @default(cuid())
  auctionPlayerId    String
  auctionPlayer      AuctionPlayer    @relation(fields: [auctionPlayerId], references: [id], onDelete: Cascade)
  teamAuctionEntryId String
  teamAuctionEntry   TeamAuctionEntry @relation(fields: [teamAuctionEntryId], references: [id])
  amount             Decimal          @db.Decimal(12, 2)
  createdAt          DateTime         @default(now())

  @@index([auctionPlayerId, createdAt])
  @@map("bids")
}

model FantasyTeam {
  id        String   @id @default(cuid())
  auctionId String
  auction   Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  picks FantasyTeamPlayer[]

  @@unique([auctionId, userId])
  @@map("fantasy_teams")
}

model FantasyTeamPlayer {
  id              String        @id @default(cuid())
  fantasyTeamId   String
  fantasyTeam     FantasyTeam   @relation(fields: [fantasyTeamId], references: [id], onDelete: Cascade)
  auctionPlayerId String
  auctionPlayer   AuctionPlayer @relation(fields: [auctionPlayerId], references: [id])
  price           Decimal       @db.Decimal(12, 2)

  @@unique([fantasyTeamId, auctionPlayerId])
  @@index([fantasyTeamId])
  @@map("fantasy_team_players")
}

model TeamAuctionEntry {
  id                   String                 @id @default(cuid())
  teamId               String
  team                 Team                   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  auctionId            String
  auction              Auction                @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  status               TeamAuctionEntryStatus @default(CREATED)
  budgetRemaining      Decimal                @db.Decimal(12, 2)
  managerPriceOverride Decimal?               @db.Decimal(10, 2)
  slotsFilled          Int                    @default(0)
  slotsTotal           Int
  analyticsEnabled     Boolean                @default(false)

  draftSubmissions      PreAuctionSubmission[]
  playersWon            AuctionPlayer[]               @relation("SoldPlayers")
  currentlyLeadingOn    AuctionPlayer[]               @relation("CurrentBidder")
  bids                  Bid[]
  playerPreferences     AuctionPlayerPreference[]
  categoryBudgetTargets AuctionCategoryBudgetTarget[]
  predictionsMade       AuctionPlayerPrediction[]     @relation("PredictionsMadeBy")
  predictedToWin        AuctionPlayerPrediction[]     @relation("PredictedWinner")

  @@unique([teamId, auctionId])
  @@index([auctionId])
  @@map("team_auction_entries")
}

model AuctionPlayerPreference {
  id                 String                 @id @default(cuid())
  teamAuctionEntryId String
  teamAuctionEntry   TeamAuctionEntry       @relation(fields: [teamAuctionEntryId], references: [id], onDelete: Cascade)
  auctionPlayerId    String
  auctionPlayer      AuctionPlayer          @relation(fields: [auctionPlayerId], references: [id], onDelete: Cascade)
  type               StrategyPreferenceType
  createdAt          DateTime               @default(now())

  @@unique([teamAuctionEntryId, auctionPlayerId])
  @@index([teamAuctionEntryId, type])
  @@map("auction_player_preferences")
}

model AuctionCategoryBudgetTarget {
  id                 String           @id @default(cuid())
  teamAuctionEntryId String
  teamAuctionEntry   TeamAuctionEntry @relation(fields: [teamAuctionEntryId], references: [id], onDelete: Cascade)
  categoryId         String
  category           AuctionCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  targetAvgPrice     Decimal          @db.Decimal(12, 2)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([teamAuctionEntryId, categoryId])
  @@map("auction_category_budget_targets")
}

/**
 * A team's private guess at which other team will win a not-yet-sold
 * player — never visible to any team other than the one that made it.
 */
model AuctionPlayerPrediction {
  id                     String           @id @default(cuid())
  teamAuctionEntryId     String
  teamAuctionEntry       TeamAuctionEntry @relation("PredictionsMadeBy", fields: [teamAuctionEntryId], references: [id], onDelete: Cascade)
  auctionPlayerId        String
  auctionPlayer          AuctionPlayer    @relation(fields: [auctionPlayerId], references: [id], onDelete: Cascade)
  predictedWinnerEntryId String
  predictedWinnerEntry   TeamAuctionEntry @relation("PredictedWinner", fields: [predictedWinnerEntryId], references: [id], onDelete: Cascade)
  /**
   * This manager's own guess at what the predicted winner would pay — used
   * to estimate that team's "reserved" budget and its likely ceiling on
   * whichever player is currently on the clock. Optional: a team can be
   * predicted without a price guess.
   */
  predictedAmount        Decimal?         @db.Decimal(12, 2)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  @@unique([teamAuctionEntryId, auctionPlayerId])
  @@index([teamAuctionEntryId])
  @@map("auction_player_predictions")
}

model PreAuctionSubmission {
  id                 String           @id @default(cuid())
  teamAuctionEntryId String
  teamAuctionEntry   TeamAuctionEntry @relation(fields: [teamAuctionEntryId], references: [id], onDelete: Cascade)
  auctionPlayerId    String
  auctionPlayer      AuctionPlayer    @relation(fields: [auctionPlayerId], references: [id], onDelete: Cascade)
  createdAt          DateTime         @default(now())

  @@unique([teamAuctionEntryId, auctionPlayerId])
  @@map("pre_auction_submissions")
}

model LoginEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  loginAt   DateTime @default(now())
  ipAddress String?
  userAgent String?

  @@index([userId])
  @@index([loginAt])
  @@map("login_events")
}

model AnalyticsSession {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  // Accumulated active time, built up incrementally by touchSession — each
  // heartbeat adds the gap since the last one, capped so a multi-day gap
  // between visits (same login, JWT session persists for weeks) doesn't
  // count as time spent. Deliberately not derived from lastSeenAt -
  // startedAt, which would span calendar time since login, not actual usage.
  activeMs   Int      @default(0)

  @@index([userId])
  @@index([lastSeenAt])
  @@map("analytics_sessions")
}

model SponsorClickEvent {
  id        String            @id @default(cuid())
  sponsorId String
  sponsor   TournamentSponsor @relation(fields: [sponsorId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  clickedAt DateTime          @default(now())

  @@index([sponsorId])
  @@index([userId])
  @@index([clickedAt])
  @@map("sponsor_click_events")
}
