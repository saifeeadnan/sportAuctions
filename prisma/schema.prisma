// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  LEAGUE_ADMIN
  TEAM_MANAGER
  AUCTIONEER
  VIEWER
}

enum TournamentStatus {
  DRAFT
  ACTIVE
  COMPLETED
}

enum AuctionStatus {
  CREATED
  PRE_AUCTION_OPEN
  PRE_AUCTION_LOCKED
  BIDDING
  COMPLETED
}

enum AuctionType {
  LIVE
  SILENT
  FIXED_PRICE
}

enum OnClockTemplate {
  CLASSIC
  PHOTO_FOCUS
  STATS_TABLE
}

enum AuctionPlayerStatus {
  AVAILABLE
  IN_PRE_AUCTION_POOL
  IN_BIDDING
  SOLD
  UNSOLD
}

enum SoldVia {
  PRE_AUCTION_DRAFT
  LIVE_BID
  ADMIN_ASSIGNED
  ADMIN_REPLACED
}

enum AuctionCorrectionType {
  SOLD_PRICE
  CATEGORY_BASE_PRICE
  TEAM_BUDGET
}

enum TeamAuctionEntryStatus {
  CREATED
  PRE_AUCTION_DRAFTING
  PRE_AUCTION_SUBMITTED
  ALLOCATED_PRE_AUCTION
  AUCTION_LIVE
  FINAL
}

enum StrategyPreferenceType {
  MUST_HAVE
  AVOID
}

// Prestige ladder for a per-tournament sponsor placement — a fixed,
// predefined set (not user-defined names), independent of the sponsor
// company itself (the same sponsor can be TITLE for one tournament and
// COMMUNITY for another — addExistingTournamentSponsor never copies this).
// Declaration order here IS the prestige sort order — Postgres enums sort
// by CREATE TYPE declaration order, not alphabetically — listTournamentSponsors
// relies on this via `orderBy: [{ tier: "asc" }, ...]`. Keep in sync with
// lib/sponsorTiers.ts's SPONSOR_TIERS array if this is ever reordered.
enum SponsorTier {
  TITLE
  MARQUEE
  COMMUNITY
}

model User {
  id           String   @id @default(cuid())
  loginId      String   @unique
  passwordHash String
  name         String
  // Optional, unique when provided — not backfilled for existing accounts.
  // Useful as a dedupe/lookup key when re-associating a returning person
  // with a new league.
  email        String?  @unique
  phone        String?  @unique
  // A site Admin isn't "a member of" any league — modeled as a flag rather
  // than a LeagueMembership row with a null leagueId, so
  // @@unique([userId, leagueId]) on LeagueMembership stays meaningful.
  isSiteAdmin  Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  memberships        LeagueMembership[]
  createdRosters     PlayerRoster[]
  managedTeams       Team[]
  createdTournaments Tournament[]
  createdAuctions    Auction[]
  fantasyTeams       FantasyTeam[]
  uploadedRulesDocs  TournamentDocument[]
  loginEvents        LoginEvent[]
  analyticsSessions  AnalyticsSession[]
  sponsorClicks      SponsorClickEvent[]
  auctionCorrections AuctionCorrectionLog[]

  @@map("users")
}

/// One row per league a person belongs to, with the role they hold there.
/// Replaces User.role/leagueId/managerBasePrice once every call site has
/// migrated to reading membership data (see Migration B).
model LeagueMembership {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  leagueId         String
  league           League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  // Never ADMIN — a site Admin is User.isSiteAdmin, not a membership.
  // Enforced in the service layer, same as every other business invariant
  // in this codebase (no DB-level CHECK constraint).
  role             Role
  managerBasePrice Decimal? @db.Decimal(10, 2)
  // Per-league approval gate — a self-registered membership starts false
  // (pending that league's admin approval); admin-added memberships start
  // true. Independent of User.isActive, which gates login itself.
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  @@unique([userId, leagueId])
  @@index([leagueId])
  @@map("league_memberships")
}

model League {
  id                       String    @id @default(cuid())
  name                     String    @unique
  type                     String
  // Informational only — doesn't gate anything. Only endDate drives
  // read-only mode (see isLeagueReadOnly in league.service.ts).
  startDate                DateTime?
  endDate                  DateTime?
  // Nullable = unlimited/no cap configured. These become plan limits once
  // pricing tiers exist; every existing league has none of this data today.
  maxTournaments           Int?
  maxTeamsPerTournament    Int?
  maxSponsorsPerTournament Int?
  createdAt                DateTime  @default(now())

  memberships LeagueMembership[]
  rosters     PlayerRoster[]
  tournaments Tournament[]
  logo        LeagueLogo?

  @@map("leagues")
}

model PlayerRoster {
  id          String   @id @default(cuid())
  name        String
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  leagueId    String
  league      League   @relation(fields: [leagueId], references: [id])
  createdAt   DateTime @default(now())

  players     Player[]
  tournaments Tournament[]

  @@index([leagueId])
  @@map("player_rosters")
}

model Player {
  id              String       @id @default(cuid())
  rosterId        String
  roster          PlayerRoster @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  name            String
  position        String?
  age             Int?
  loginId         String?
  defaultCategory String?
  previousTeam    String?
  photoUrl        String?
  rating          Decimal?     @db.Decimal(6, 2)
  battingRating   Decimal?     @db.Decimal(6, 2)
  bowlingRating   Decimal?     @db.Decimal(6, 2)
  fieldingRating  Decimal?     @db.Decimal(6, 2)
  priorStats      Json?
  createdAt       DateTime     @default(now())

  auctionPlayers AuctionPlayer[]

  @@index([rosterId])
  @@map("players")
}

model Tournament {
  id          String           @id @default(cuid())
  name        String
  rosterId    String?
  roster      PlayerRoster?    @relation(fields: [rosterId], references: [id])
  numTeams    Int
  squadSize   Int
  startDate   DateTime
  endDate     DateTime
  status      TournamentStatus @default(DRAFT)
  createdById String
  createdBy   User             @relation(fields: [createdById], references: [id])
  leagueId    String
  league      League           @relation(fields: [leagueId], references: [id])
  createdAt   DateTime         @default(now())

  teams         Team[]
  auctions      Auction[]
  rulesDocument TournamentDocument?
  sponsors      TournamentSponsor[]

  @@index([rosterId])
  @@index([leagueId])
  @@map("tournaments")
}

model TournamentDocument {
  id           String     @id @default(cuid())
  tournamentId String     @unique
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  fileName     String
  mimeType     String
  data         Bytes
  uploadedById String
  uploadedBy   User       @relation(fields: [uploadedById], references: [id])
  uploadedAt   DateTime   @default(now())

  @@map("tournament_documents")
}

model TournamentSponsor {
  id           String      @id @default(cuid())
  tournamentId String
  tournament   Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name         String
  tier         SponsorTier @default(COMMUNITY)
  websiteUrl   String?
  logoUrl      String?
  mimeType     String?
  data         Bytes?
  createdAt    DateTime    @default(now())

  clicks SponsorClickEvent[]

  @@index([tournamentId])
  @@map("tournament_sponsors")
}

model TeamSponsorImage {
  id         String   @id @default(cuid())
  teamId     String   @unique
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  mimeType   String
  data       Bytes
  uploadedAt DateTime @default(now())

  @@map("team_sponsor_images")
}

model LeagueLogo {
  id         String   @id @default(cuid())
  leagueId   String   @unique
  league     League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  mimeType   String
  data       Bytes
  uploadedAt DateTime @default(now())

  @@map("league_logos")
}

model Team {
  id                  String     @id @default(cuid())
  tournamentId        String
  tournament          Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name                String
  managerId           String?
  manager             User?      @relation(fields: [managerId], references: [id])
  managerOccupiesSlot Boolean    @default(true)
  createdAt           DateTime   @default(now())

  entries      TeamAuctionEntry[]
  sponsorImage TeamSponsorImage?

  @@unique([tournamentId, name])
  @@index([managerId])
  @@map("teams")
}

model Auction {
  id           String        @id @default(cuid())
  tournamentId String
  tournament   Tournament    @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name         String
  teamBudget   Decimal       @db.Decimal(12, 2)
  status       AuctionStatus @default(CREATED)
  auctionType  AuctionType   @default(LIVE)
  createdById  String
  createdBy    User          @relation(fields: [createdById], references: [id])
  createdAt    DateTime      @default(now())
  startedAt    DateTime?
  completedAt  DateTime?
  // When true, this auction skips the pre-auction draft phase entirely —
  // startBiddingDirect takes it straight from CREATED to BIDDING.
  skipPreAuctionDraft  Boolean         @default(false)
  onClockTemplate      OnClockTemplate @default(CLASSIC)
  // Keys into lib/onClockDisplay.ts's ON_CLOCK_FIELD_KEYS — which optional
  // Player fields show on the "On the clock" card, validated in the service
  // layer against that same list.
  onClockVisibleFields String[]        @default(["photoUrl", "previousTeam"])
  // Visual-only lot countdown shown during live bidding — resets on every
  // bid, never auto-resolves anything. Null = no timer for this auction.
  // Write-once at creation, same posture as skipPreAuctionDraft.
  lotTimerSeconds          Int?
  // Lets an UNSOLD player be re-offered later at a reduced price. Write-once
  // at creation; reAuctionDiscountPercent is only meaningful when this is true.
  reAuctionEnabled         Boolean         @default(false)
  reAuctionDiscountPercent Int?
  // Set only via getOrCreateHighlightsToken, once an admin explicitly
  // requests a public recap link for this COMPLETED auction. Nullable —
  // most auctions never get one; not backfilled for existing rows (same
  // posture as User.email above).
  highlightsToken String? @unique

  categories     AuctionCategory[]
  auctionPlayers AuctionPlayer[]
  entries        TeamAuctionEntry[]
  fantasyTeams   FantasyTeam[]
  correctionLogs AuctionCorrectionLog[]

  @@index([tournamentId])
  @@map("auctions")
}

// An admin-initiated correction to a COMPLETED auction's recorded data (sold
// price / category base price / team budget), each row a before/after
// snapshot for accountability. targetId is a bare id (AuctionPlayer.id /
// AuctionCategory.id / null for TEAM_BUDGET) rather than a typed relation —
// polymorphic, and nothing needs to `include` through it today.
model AuctionCorrectionLog {
  id             String                @id @default(cuid())
  auctionId      String
  auction        Auction               @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  adminUserId    String
  adminUser      User                  @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  correctionType AuctionCorrectionType
  targetId       String?
  oldValue       Decimal               @db.Decimal(12, 2)
  newValue       Decimal               @db.Decimal(12, 2)
  note           String?
  createdAt      DateTime              @default(now())

  @@index([auctionId])
  @@index([adminUserId])
  @@index([createdAt])
  @@map("auction_correction_logs")
}

model AuctionCategory {
  id                 String   @id @default(cuid())
  auctionId          String
  auction            Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  name               String
  basePrice          Decimal  @db.Decimal(12, 2)
  preAuctionEligible Boolean  @default(true)
  bidIncrement       Decimal? @db.Decimal(12, 2)

  auctionPlayers       AuctionPlayer[]
  budgetTargets        AuctionCategoryBudgetTarget[]
  rivalBudgetEstimates RivalCategoryBudgetEstimate[]

  @@unique([auctionId, name])
  @@map("auction_categories")
}

model AuctionPlayer {
  id                   String              @id @default(cuid())
  auctionId            String
  auction              Auction             @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  playerId             String
  player               Player              @relation(fields: [playerId], references: [id])
  categoryId           String
  category             AuctionCategory     @relation(fields: [categoryId], references: [id])
  status               AuctionPlayerStatus @default(AVAILABLE)
  soldVia              SoldVia?
  soldToEntryId        String?
  soldToEntry          TeamAuctionEntry?   @relation("SoldPlayers", fields: [soldToEntryId], references: [id])
  soldPrice            Decimal?            @db.Decimal(12, 2)
  soldAt               DateTime?
  biddingOrder         Int?
  points               Decimal?            @db.Decimal(10, 2)
  currentBidAmount     Decimal?            @db.Decimal(12, 2)
  currentBidderEntryId String?
  currentBidderEntry   TeamAuctionEntry?   @relation("CurrentBidder", fields: [currentBidderEntryId], references: [id])
  bidCooldownUntil     DateTime?
  // Mirrors bidCooldownUntil's shape: set in selectNextPlayer and on every
  // placeBid, cleared on sale/unsold/reset. Purely cosmetic — nothing reads
  // this to auto-resolve the lot.
  lotTimerDeadline      DateTime?
  // First-unsold-transition discount snapshot: once set, this is the
  // player's new effective base price for every future re-offer and never
  // changes again. A per-row snapshot, not a live formula — same reasoning
  // as updateAuctionPlayerCategory's categoryId snapshot.
  discountedBasePrice   Decimal?  @db.Decimal(12, 2)
  // Authoritative "already used its one reduced-price attempt" flag.
  reAuctionDiscountUsed Boolean   @default(false)

  draftPicks   PreAuctionSubmission[]
  fantasyPicks FantasyTeamPlayer[]
  bids         Bid[]
  preferences  AuctionPlayerPreference[]
  predictions  AuctionPlayerPrediction[]

  @@unique([auctionId, playerId])
  @@index([auctionId, status])
  @@map("auction_players")
}

model Bid {
  id                 String           @id @default(cuid())
  auctionPlayerId    String
  auctionPlayer      AuctionPlayer    @relation(fields: [auctionPlayerId], references: [id], onDelete: Cascade)
  teamAuctionEntryId String
  teamAuctionEntry   TeamAuctionEntry @relation(fields: [teamAuctionEntryId], references: [id])
  amount             Decimal          @db.Decimal(12, 2)
  createdAt          DateTime         @default(now())

  @@index([auctionPlayerId, createdAt])
  @@map("bids")
}

model FantasyTeam {
  id        String   @id @default(cuid())
  auctionId String
  auction   Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  // Optional display name, chosen by the user — null falls back to
  // showing user.name wherever a fantasy team's identity is displayed.
  // Follows the same edit lifecycle as picks: settable on every
  // resubmission until isFantasyEditingLocked trips.
  name      String?
  createdAt DateTime @default(now())

  picks FantasyTeamPlayer[]

  @@unique([auctionId, userId])
  @@map("fantasy_teams")
}

model FantasyTeamPlayer {
  id              String        @id @default(cuid())
  fantasyTeamId   String
  fantasyTeam     FantasyTeam   @relation(fields: [fantasyTeamId], references: [id], onDelete: Cascade)
  auctionPlayerId String
  auctionPlayer   AuctionPlayer @relation(fields: [auctionPlayerId], references: [id])
  price           Decimal       @db.Decimal(12, 2)

  @@unique([fantasyTeamId, auctionPlayerId])
  @@index([fantasyTeamId])
  @@map("fantasy_team_players")
}

model TeamAuctionEntry {
  id                   String                 @id @default(cuid())
  teamId               String
  team                 Team                   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  auctionId            String
  auction              Auction                @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  status               TeamAuctionEntryStatus @default(CREATED)
  budgetRemaining      Decimal                @db.Decimal(12, 2)
  managerPriceOverride Decimal?               @db.Decimal(10, 2)
  slotsFilled          Int                    @default(0)
  slotsTotal           Int
  analyticsEnabled     Boolean                @default(false)

  draftSubmissions       PreAuctionSubmission[]
  playersWon             AuctionPlayer[]               @relation("SoldPlayers")
  currentlyLeadingOn     AuctionPlayer[]               @relation("CurrentBidder")
  bids                   Bid[]
  playerPreferences      AuctionPlayerPreference[]
  categoryBudgetTargets  AuctionCategoryBudgetTarget[]
  predictionsMade        AuctionPlayerPrediction[]     @relation("PredictionsMadeBy")
  predictedToWin         AuctionPlayerPrediction[]     @relation("PredictedWinner")
  categoryEstimatesMade  RivalCategoryBudgetEstimate[] @relation("CategoryEstimatesMadeBy")
  categoryEstimatesAbout RivalCategoryBudgetEstimate[] @relation("CategoryEstimateTarget")

  @@unique([teamId, auctionId])
  @@index([auctionId])
  @@map("team_auction_entries")
}

model AuctionPlayerPreference {
  id                 String                 @id @default(cuid())
  teamAuctionEntryId String
  teamAuctionEntry   TeamAuctionEntry       @relation(fields: [teamAuctionEntryId], references: [id], onDelete: Cascade)
  auctionPlayerId    String
  auctionPlayer      AuctionPlayer          @relation(fields: [auctionPlayerId], references: [id], onDelete: Cascade)
  type               StrategyPreferenceType
  createdAt          DateTime               @default(now())

  @@unique([teamAuctionEntryId, auctionPlayerId])
  @@index([teamAuctionEntryId, type])
  @@map("auction_player_preferences")
}

model AuctionCategoryBudgetTarget {
  id                 String           @id @default(cuid())
  teamAuctionEntryId String
  teamAuctionEntry   TeamAuctionEntry @relation(fields: [teamAuctionEntryId], references: [id], onDelete: Cascade)
  categoryId         String
  category           AuctionCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  targetAvgPrice     Decimal          @db.Decimal(12, 2)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([teamAuctionEntryId, categoryId])
  @@map("auction_category_budget_targets")
}

/**
 * A team's private guess at which other team will win a not-yet-sold
 * player — never visible to any team other than the one that made it.
 */
model AuctionPlayerPrediction {
  id                     String           @id @default(cuid())
  teamAuctionEntryId     String
  teamAuctionEntry       TeamAuctionEntry @relation("PredictionsMadeBy", fields: [teamAuctionEntryId], references: [id], onDelete: Cascade)
  auctionPlayerId        String
  auctionPlayer          AuctionPlayer    @relation(fields: [auctionPlayerId], references: [id], onDelete: Cascade)
  predictedWinnerEntryId String
  predictedWinnerEntry   TeamAuctionEntry @relation("PredictedWinner", fields: [predictedWinnerEntryId], references: [id], onDelete: Cascade)
  /**
   * This manager's own guess at what the predicted winner would pay — used
   * to estimate that team's "reserved" budget and its likely ceiling on
   * whichever player is currently on the clock. Optional: a team can be
   * predicted without a price guess.
   */
  predictedAmount        Decimal?         @db.Decimal(12, 2)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  @@unique([teamAuctionEntryId, auctionPlayerId])
  @@index([teamAuctionEntryId])
  @@map("auction_player_predictions")
}

/**
 * A manager's own private estimate of a team's (rival or their own) budget
 * for a category — never visible to any team other than the one that made
 * it. Feeds the Auction Analytics v2 console's rival-affordability panel
 * (lib/auction-analytics/rivalCategoryEstimate.ts); the estimated count per
 * category is derived live from this budget and the category's live
 * average price, not stored separately.
 */
model RivalCategoryBudgetEstimate {
  id                 String           @id @default(cuid())
  teamAuctionEntryId String
  teamAuctionEntry   TeamAuctionEntry @relation("CategoryEstimatesMadeBy", fields: [teamAuctionEntryId], references: [id], onDelete: Cascade)
  targetEntryId      String
  targetEntry        TeamAuctionEntry @relation("CategoryEstimateTarget", fields: [targetEntryId], references: [id], onDelete: Cascade)
  categoryId         String
  category           AuctionCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  estimatedBudget    Decimal          @db.Decimal(12, 2)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([teamAuctionEntryId, targetEntryId, categoryId])
  @@map("rival_category_budget_estimates")
}

model PreAuctionSubmission {
  id                 String           @id @default(cuid())
  teamAuctionEntryId String
  teamAuctionEntry   TeamAuctionEntry @relation(fields: [teamAuctionEntryId], references: [id], onDelete: Cascade)
  auctionPlayerId    String
  auctionPlayer      AuctionPlayer    @relation(fields: [auctionPlayerId], references: [id], onDelete: Cascade)
  createdAt          DateTime         @default(now())

  @@unique([teamAuctionEntryId, auctionPlayerId])
  @@map("pre_auction_submissions")
}

model LoginEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  loginAt   DateTime @default(now())
  ipAddress String?
  userAgent String?

  @@index([userId])
  @@index([loginAt])
  @@map("login_events")
}

model AnalyticsSession {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  // Accumulated active time, built up incrementally by touchSession — each
  // heartbeat adds the gap since the last one, capped so a multi-day gap
  // between visits (same login, JWT session persists for weeks) doesn't
  // count as time spent. Deliberately not derived from lastSeenAt -
  // startedAt, which would span calendar time since login, not actual usage.
  activeMs   Int      @default(0)

  @@index([userId])
  @@index([lastSeenAt])
  @@map("analytics_sessions")
}

model SponsorClickEvent {
  id        String            @id @default(cuid())
  sponsorId String
  sponsor   TournamentSponsor @relation(fields: [sponsorId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  clickedAt DateTime          @default(now())

  @@index([sponsorId])
  @@index([userId])
  @@index([clickedAt])
  @@map("sponsor_click_events")
}
